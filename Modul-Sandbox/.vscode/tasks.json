{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Workspace: Configure",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "python",
        "-u",
        "scripts/workspace_bootstrap.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Docs: Serve",
      "type": "shell",
      "command": "powershell",
      "linux": {
        "command": "pwsh"
      },
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/preview_local_content.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Docs: Validate (Strict)",
      "type": "shell",
      "command": "powershell",
      "linux": {
        "command": "pwsh"
      },
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/preview_local_content.ps1",
        "-Validate"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
